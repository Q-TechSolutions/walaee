# ── نظام التشغيل ─────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*~

# ── المحررات ─────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── الأسرار ──────────────────────────────────────────────
# الملف الفعّال وحده يُستبعَد. القالبان `.env.local` و
# `.env.production` مرفوعان عمدًا: لا يحويان سرًّا، وهما ما
# يُنسخ منه — `cp .env.local .env` أو اللصق في لوحة المنصّة.
.env
.env.*
!.env.local
!.env.production
*.pem
*.key

# ── بايثون ───────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ── جافاسكريبت ───────────────────────────────
node_modules/
dist/
.vite/
npm-debug.log*
frontend/*/dist/
frontend/*/dev-dist/
frontend/*/.vite/
*.tsbuildinfo

# ── مخرجات البناء ────────────────────────────
backend/staticfiles/
backend/media/*
!backend/media/.gitkeep
infra/openapi.yaml

# ── النسخ الاحتياطية ─────────────────────────
# تحوي بيانات عملاء حقيقية. مكانها تخزين بعيد مشفّر لا مستودع كود.
backups/
*.sql
*.sql.gz
*.dump

# ── مخرجات مؤقتة ─────────────────────────────
*.log
tmp/

# ── مستندات عمل محلية لا تُرفع ────────────────
# مسوّدات ومراجع شخصية — مكانها مستودع العرض لا مستودع المنتج
*.docx
*.doc
*.pptx
*.xlsx
