# ══════════════════════════════════════════════════════════
#  ولائي — النشر على خادم  (Dokploy · Coolify · خادم عادي)
#
#  على منصّة نشر: انسخ هذا الملف **كاملًا** إلى تبويب Environment.
#  على خادم عادي:  cp .env.production .env
#
#  ثم غيّر سطرين فقط:  SECRET_KEY  و  POSTGRES_PASSWORD
#
#  ⚠ السطر الذي يبدأ بـ `#` تعليق لا يُضبط. لا تُعلّق سطر قيمة —
#    متغيّر مفقود يعني خدمة لا تقوم:
#      POSTGRES_PASSWORD ناقص  →  postgres لا يُهيّئ القاعدة
#      SECRET_KEY ناقص         →  Django يرفض الإقلاع
#      ALLOWED_HOSTS ناقص      →  كل طلب يردّ 400
#
#  هذا إعداد **نشر عرض**: الحسابات معلنة وأي شخص يفتح الرابط
#  يدخل بها. راجع «قبل التحوّل إلى إنتاج حقيقي» في docs/DEPLOY.md.
# ══════════════════════════════════════════════════════════

DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=0

# ولّده ولا تترك هذه القيمة:
#   python -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(50)))"
SECRET_KEY=CHANGE_ME_50_RANDOM_CHARACTERS_XXXXXXXXXXXXXXXXXXXX

# `web` و`api` إلزاميان: الفحوص الصحية تأتي من داخل الشبكة بهذين
# الاسمين، وغيابهما يجعل كل فحص يردّ 400 فتتراجع المنصّة عن نشر سليم
ALLOWED_HOSTS=walaee.deplois.net,web,api,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://walaee.deplois.net

# ── قاعدة البيانات ───────────────────────────────────────
# العناوين الداخلية مثبّتة في docker-compose.yml وتعلو على ما هنا،
# فلا حاجة لضبط POSTGRES_HOST. لا تضف DATABASE_URL إطلاقًا.
POSTGRES_DB=walaee
POSTGRES_USER=walaee
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CONN_MAX_AGE=60

# ── الرموز والولاء ───────────────────────────────────────
POS_CODE_TTL_SECONDS=35
POS_CODE_ROTATE_SECONDS=30
REDEMPTION_CODE_TTL_MINUTES=15
DEFAULT_EXPIRY_MONTHS=12

# ── القنوات ──────────────────────────────────────────────
# فارغة حتى التعاقد مع مزوّد (القراران ٧ و٨). المزوّدون يعملون
# بوضع «console» فتُسجَّل الرسائل بدل إرسالها.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
SMS_PROVIDER=local_eg
SMS_API_KEY=
SMS_SENDER_ID=WALAEE

# ── الدفع والمراقبة ──────────────────────────────────────
PAYMENT_GATEWAY=paymob
PAYMENT_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# ── مفاتيح الميزات حسب الباقة (النطاق المعتمد) ──────────
FEATURE_PUBLIC_API=0
FEATURE_AI_INSIGHTS=0

# ── ما يجعل الرابط قابلًا للتجربة فورًا ──────────────────
# بدونها تُقفل كل شاشات الدخول: الدخول يحتاج كودًا يصل برسالة،
# ولا مزوّد رسائل متعاقَدًا عليه بعد. فرّغ السطرين قبل أي عملاء
# حقيقيين — عندها تتعطّل الميزة بالكامل.
DEMO_LOGIN_PHONES=01111111111,01222222222,01333333333
DEMO_LOGIN_CODE=123456
DEMO_STAFF_PASSWORD=Walaee@2026
DEMO_APP_URLS=

# ── الأمان ───────────────────────────────────────────────
# ‏1 لأن Traefik يصدر الشهادة ويوجّه https.
# اضبطه 0 مؤقتًا إن نشرت على http بلا شهادة، وإلا قوبل كل نداء
# API بـ301 إلى https لا يستمع إليه أحد.
SECURE_SSL_REDIRECT=1

# ── تعبئة البيانات عند أول إقلاع ─────────────────────────
# الشبكة العامة (٩٦ فرعًا) و١٢ شهرًا من النشاط. اضبطهما 0 لنشر فارغ.
WALAEE_SEED_NETWORK=1
WALAEE_SEED_ACTIVITY=1

# ── المنفذ المنشور على المضيف ────────────────────────────
# النطاق يمرّ عبر شبكة Docker لا عبر هذا المنفذ. غيّره إن كان
# ٨٠٨٠ مشغولًا على الخادم، وإلا فشل النشر بتعارض منافذ.
WEB_PORT=8080
