{
  "name": "walaee-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "landing",
    "shared",
    "customer-pwa",
    "merchant-dashboard",
    "admin-panel"
  ],
  "scripts": {
    "dev:customer": "npm run dev -w @walaee/customer-pwa",
    "dev:merchant": "npm run dev -w @walaee/merchant-dashboard",
    "dev:admin": "npm run dev -w @walaee/admin-panel",
    "build": "npm run build -w @walaee/landing && npm run build -w @walaee/customer-pwa && npm run build -w @walaee/merchant-dashboard && npm run build -w @walaee/admin-panel",
    "lint": "eslint .",
    "typecheck": "tsc --build --force",
    "dev:landing": "npm run dev -w @walaee/landing"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "@types/node": "^22.10.2"
  }
}
