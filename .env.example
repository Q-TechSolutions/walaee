# ══════════════════════════════════════════════════════════
#  ولائي — متغيرات البيئة
#  انسخه إلى .env واملأ القيم.  ملف .env لا يُرفع على git إطلاقًا.
#  المرجع: docs/architecture/ — قسم ١١
# ══════════════════════════════════════════════════════════

# ── أساسي ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-50-random-characters
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── قاعدة البيانات ───────────────────────────────────────
# هذه العناوين للتشغيل من المضيف (`make run` و `make test`).
# تركيبة الإنتاج لا تقرأها: عناوين الخدمات داخل شبكة Docker
# مثبتة في docker-compose.prod.yml. فوضع `127.0.0.1:5433` هنا
# للعمل المحلي لا يكسر نشرًا — وهذا مقصود.
POSTGRES_DB=walaee
POSTGRES_USER=walaee
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ملاحظة: لا يوجد DATABASE_URL هنا عمدًا.
# كلمة المرور في متغيّر واحد فقط. وجودها مرة ثانية داخل رابط
# اتصال يعني نسختين تنحرفان بصمت — وقد حدث ذلك فعلًا: بقي الرابط
# يحمل كلمة المرور القديمة بينما تغيّرت الأخرى، فظل الخادم عالقًا
# على «انتظار قاعدة البيانات» بلا رسالة تشرح السبب.
# نقطة الدخول تبني الرابط من هذه المتغيرات — راجع infra/scripts/entrypoint.sh
CONN_MAX_AGE=60

# ── Redis و Celery ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── الرموز والولاء ───────────────────────────────────────
POS_CODE_TTL_SECONDS=35
POS_CODE_ROTATE_SECONDS=30
REDEMPTION_CODE_TTL_MINUTES=15
DEFAULT_EXPIRY_MONTHS=12

# ── القنوات ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
SMS_PROVIDER=local_eg
SMS_API_KEY=
SMS_SENDER_ID=WALAEE

# ── الدفع والمراقبة ──────────────────────────────────────
PAYMENT_GATEWAY=paymob
PAYMENT_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# ── مفاتيح الميزات حسب الباقة (النطاق المعتمد) ──────────
FEATURE_PUBLIC_API=0
FEATURE_AI_INSIGHTS=0

# ── حسابات التجربة ───────────────────────────────────────
# أرقام محدّدة بالاسم تقبل كودًا ثابتًا، لأن مزوّد الرسائل لم
# يُتعاقَد عليه بعد (القرار ٧). الأثر محصور في هذه الأرقام وحدها:
# أي رقم آخر يمر بالمسار الكامل بكود عشوائي مُجزّأ.
# اترك القائمة فارغة لتعطيل الميزة بالكامل.
DEMO_LOGIN_PHONES=
DEMO_LOGIN_CODE=
# كلمة مرور موظفي التجربة. ضبطها يجعل شاشات الدخول تعرض الحسابات
# للدخول بضغطة، ويجعل نقطة الإقلاع تنشئها تلقائيًا.
DEMO_STAFF_PASSWORD=
# مسارات التطبيقات حين تُخدَم على نطاقات منفصلة. الافتراضي يطابق
# ما يخدمه nginx: / و /app/ و /merchant/ و /admin/
# مثال: customer=https://app.example,merchant=https://merchant.example
DEMO_APP_URLS=

# ── الأمان ───────────────────────────────────────────────
# التحويل إلى https. اتركه 1 في الإنتاج الحقيقي خلف Traefik.
# اضبطه 0 لنشر تجريبي على http مباشرة: بدون ذلك يُقابَل كل نداء
# API بـ301 إلى https لا يستمع إليه أحد، فيرى المستخدم
# «Failed to fetch» بلا أي أثر في السجل يشرح السبب.
SECURE_SSL_REDIRECT=1

# ── الواجهات ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ══════════════════════════════════════════════════════════
#  النشر العام على walaee.deplois.net  (Dokploy)
#
#  القيم أعلاه للتشغيل المحلي. الكتلة التالية هي ما يُلصَق في
#  تبويب Environment داخل Dokploy — انسخها كما هي وغيّر
#  `SECRET_KEY` و`POSTGRES_PASSWORD` وحدهما.
#
#  هذا نشرٌ **للعرض**: أي شخص يفتح الرابط يدخل بحسابات معلنة
#  ويرى المنصة تعمل ببيانات كاملة. ليس إنتاجًا بعملاء حقيقيين —
#  راجع «قبل التحوّل إلى إنتاج حقيقي» في docs/DEPLOY.md.
# ══════════════════════════════════════════════════════════
#
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DEBUG=0
# SECRET_KEY=<٥٠ محرفًا عشوائيًا — ولّده ولا تنسخ هذا السطر>
#
# ‏`web` و`api` إلزاميان: الفحوص الصحية تأتي من داخل الشبكة
# بهذين الاسمين، وغيابهما يجعل كل فحص يردّ 400
# ALLOWED_HOSTS=walaee.deplois.net,web,api,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://walaee.deplois.net
#
# POSTGRES_PASSWORD=<كلمة مرور قوية>
#
# ‏1 لأن Traefik يصدر الشهادة ويوجّه https — راجع قسم الأمان أعلاه
# SECURE_SSL_REDIRECT=1
#
# ── ما يجعل الرابط قابلًا للتجربة فورًا ──
# بدون هذه الأسطر تُقفل كل شاشات الدخول: الدخول يحتاج كودًا يصل
# برسالة، ولا مزوّد رسائل متعاقَدًا عليه بعد (القرار ٧).
# DEMO_LOGIN_PHONES=01111111111,01222222222,01333333333
# DEMO_LOGIN_CODE=123456
# DEMO_STAFF_PASSWORD=Walaee@2026
#
# ── بيانات تُملأ تلقائيًا عند أول إقلاع ──
# WALAEE_SEED_NETWORK=1      # ٩٦ فرعًا في ٢٧ محافظة للدليل العام
# WALAEE_SEED_ACTIVITY=1     # ١٢ شهرًا من النشاط — اضبطه 0 لنشر فارغ
