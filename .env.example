# ══════════════════════════════════════════════════════════
#  ولائي — متغيرات البيئة
#  انسخه إلى .env واملأ القيم.  ملف .env لا يُرفع على git إطلاقًا.
#  المرجع: docs/architecture/ — قسم ١١
# ══════════════════════════════════════════════════════════

# ── أساسي ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-50-random-characters
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── قاعدة البيانات ───────────────────────────────────────
POSTGRES_DB=walaee
POSTGRES_USER=walaee
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# ملاحظة: لا يوجد DATABASE_URL هنا عمدًا.
# كلمة المرور في متغيّر واحد فقط. وجودها مرة ثانية داخل رابط
# اتصال يعني نسختين تنحرفان بصمت — وقد حدث ذلك فعلًا: بقي الرابط
# يحمل كلمة المرور القديمة بينما تغيّرت الأخرى، فظل الخادم عالقًا
# على «انتظار قاعدة البيانات» بلا رسالة تشرح السبب.
# نقطة الدخول تبني الرابط من هذه المتغيرات — راجع infra/scripts/entrypoint.sh
CONN_MAX_AGE=60

# ── Redis و Celery ───────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── الرموز والولاء ───────────────────────────────────────
POS_CODE_TTL_SECONDS=35
POS_CODE_ROTATE_SECONDS=30
REDEMPTION_CODE_TTL_MINUTES=15
DEFAULT_EXPIRY_MONTHS=12

# ── القنوات ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
SMS_PROVIDER=local_eg
SMS_API_KEY=
SMS_SENDER_ID=WALAEE

# ── الدفع والمراقبة ──────────────────────────────────────
PAYMENT_GATEWAY=paymob
PAYMENT_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# ── مفاتيح الميزات حسب الباقة (النطاق المعتمد) ──────────
FEATURE_PUBLIC_API=0
FEATURE_AI_INSIGHTS=0

# ── حسابات التجربة ───────────────────────────────────────
# أرقام محدّدة بالاسم تقبل كودًا ثابتًا، لأن مزوّد الرسائل لم
# يُتعاقَد عليه بعد (القرار ٧). الأثر محصور في هذه الأرقام وحدها:
# أي رقم آخر يمر بالمسار الكامل بكود عشوائي مُجزّأ.
# اترك القائمة فارغة لتعطيل الميزة بالكامل.
DEMO_LOGIN_PHONES=
DEMO_LOGIN_CODE=

# ── الواجهات ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
