# ══════════════════════════════════════════════════════════
#  ولائي — صورة الواجهات الثلاث + الوكيل العكسي
#
#  الواجهات الأربع تُخدَم من حاوية nginx واحدة على دومين واحد:
#      /           الصفحة العامة (تشرح المنصة وتعرض الخريطة)
#      /app/       تطبيق العميل (PWA)
#      /merchant/  لوحة المتجر
#      /admin/     لوحة إدارة المنصة
#      /demo/      العرض التفاعلي — HTML ثابت
#      /api/       تمرير إلى الخلفية
#
#  حاوية واحدة لا أربع: أربع حاويات تعني أربعة دومينات وأربع
#  شهادات وأربعة تطبيقات في Dokploy — تعقيد بلا مكسب على هذا
#  النطاق. الفصل إلى دومينات فرعية ممكن لاحقًا بتغيير هذا الملف
#  وحده لأن الواجهات لا تعرف شيئًا عن مكان خدمتها.
# ══════════════════════════════════════════════════════════

FROM node:22-alpine AS builder

WORKDIR /build

# طبقة الاعتماديات منفصلة: تغيير سطر في مكوّن لا يعيد تثبيت
# ٤٠٠ حزمة في كل بناء
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/shared/package.json ./shared/
COPY frontend/landing/package.json ./landing/
COPY frontend/customer-pwa/package.json ./customer-pwa/
COPY frontend/merchant-dashboard/package.json ./merchant-dashboard/
COPY frontend/admin-panel/package.json ./admin-panel/

RUN npm ci --no-audit --no-fund

COPY frontend/ ./

# عنوان الـAPI نسبي: الواجهة والخلفية خلف نفس الوكيل، فلا CORS
# ولا دومين مدفون في الحزمة يتغيّر مع كل بيئة
ENV VITE_API_BASE_URL=/api/v1

RUN npm run build


# ══════════════ الخدمة ══════════════
FROM nginx:1.27-alpine

# عدد عمّال متناسب مع حد المعالج — `auto` يقرأ نوى المضيف كلها
# ويشغّل عشرين عاملًا داخل حاوية بنصف نواة فيخنق نفسه
RUN sed -i 's/^worker_processes.*/worker_processes 2;/' /etc/nginx/nginx.conf

COPY infra/nginx/walaee.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/proxy_headers.conf /etc/nginx/proxy_headers.conf

# الصفحة العامة على الجذر، والتطبيقات تحته. الترتيب مهم: نسخ
# الجذر بعد التطبيقات كان سيحذف ما تحته في بعض إصدارات BuildKit.
COPY --from=builder /build/landing/dist/            /usr/share/nginx/html/
COPY --from=builder /build/customer-pwa/dist/       /usr/share/nginx/html/app/
COPY --from=builder /build/merchant-dashboard/dist/ /usr/share/nginx/html/merchant/
COPY --from=builder /build/admin-panel/dist/        /usr/share/nginx/html/admin/

# العرض التفاعلي — يُنسخ من المستودع لا من البناء: HTML ثابت بلا
# أي خطوة ترجمة، ووضعه في مرحلة البناء كان سيعيد نسخه في كل
# تغيير بالواجهات بلا سبب
COPY docs/demo/ /usr/share/nginx/html/demo/

# جذر تحدّي ACME. المجلد يُنشأ فارغًا: وجوده يجعل nginx يردّ 404
# على تحدٍّ غير موجود بدل 500 على جذر مفقود — و404 هي الإجابة
# الصحيحة حين يتولى Traefik الشهادة بنفسه
RUN mkdir -p /var/www/certbot

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=4s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost/nginx-health || exit 1
