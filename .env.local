# ══════════════════════════════════════════════════════════
#  ولائي — التطوير المحلي
#
#      cp .env.local .env
#      make up && make run
#
#  يعمل كما هو: لا قيمة هنا تحتاج تغييرًا للبدء. الأسرار كلها
#  فارغة أو وهمية عمدًا — هذا ملف مرفوع على git.
#
#  للنشر على خادم استعمل `.env.production` بدلًا منه.
# ══════════════════════════════════════════════════════════

# ── أساسي ────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=1
# مفتاح تطوير معلن. الإنتاج يولّد مفتاحه — راجع .env.production
SECRET_KEY=dev-only-not-a-secret-0123456789abcdefghijklmnopqrstuv
ALLOWED_HOSTS=localhost,127.0.0.1,web,api
CSRF_TRUSTED_ORIGINS=http://localhost:5172,http://localhost:5173,http://localhost:5174,http://localhost:5175

# ── قاعدة البيانات ───────────────────────────────────────
# ══════════════════════════════════════════════════════════
#  العناوين هنا عناوين **المضيف** لا أسماء خدمات Docker.
#
#  `make run` يشغّل Django على جهازك مباشرةً — لا داخل حاوية —
#  فيصل إلى القاعدة عبر المنفذ الذي ينشره `docker-compose.dev.yml`
#  وهو ‎5433‎ لا ‎5432‎. اسم الخدمة `postgres` لا يُحلّ خارج شبكة
#  Docker، فوضعه هنا يترك الخادم عالقًا على «انتظار قاعدة
#  البيانات» بلا رسالة تشرح السبب.
#
#  والحاويات لا تتأثر بهذا: تركيبة النشر تثبّت عناوينها الداخلية
#  في `environment` وهي تعلو على ملف البيئة.
# ══════════════════════════════════════════════════════════
POSTGRES_DB=walaee
POSTGRES_USER=walaee
POSTGRES_PASSWORD=walaee
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
CONN_MAX_AGE=60
# لا تضف DATABASE_URL. كلمة المرور في متغيّر واحد فقط، ونقطة
# الدخول تبني الرابط منه — نسختان تنحرفان بصمت.

# ── Redis و Celery ───────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/2

# ── الرموز والولاء ───────────────────────────────────────
POS_CODE_TTL_SECONDS=35
POS_CODE_ROTATE_SECONDS=30
REDEMPTION_CODE_TTL_MINUTES=15
DEFAULT_EXPIRY_MONTHS=12

# ── القنوات ──────────────────────────────────────────────
# فارغة: المزوّدون يعملون بوضع «console» في التطوير فتُطبع
# الرسائل في السجل بدل إرسالها
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
SMS_PROVIDER=local_eg
SMS_API_KEY=
SMS_SENDER_ID=WALAEE

# ── الدفع والمراقبة ──────────────────────────────────────
PAYMENT_GATEWAY=paymob
PAYMENT_API_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO

# ── مفاتيح الميزات حسب الباقة (النطاق المعتمد) ──────────
FEATURE_PUBLIC_API=0
FEATURE_AI_INSIGHTS=0

# ── حسابات التجربة ───────────────────────────────────────
# الدخول يحتاج كودًا يصل برسالة، ولا مزوّد متعاقَدًا عليه بعد
# (القرار ٧). هذه الأرقام وحدها تقبل كودًا ثابتًا — أي رقم آخر
# يمرّ بالمسار الكامل بكود عشوائي مُجزّأ.
DEMO_LOGIN_PHONES=01111111111,01222222222,01333333333
DEMO_LOGIN_CODE=123456
DEMO_STAFF_PASSWORD=Walaee@2026
DEMO_APP_URLS=

# ── الأمان ───────────────────────────────────────────────
# ‏0 محليًا: التطوير على http، والتحويل إلى https يقابل كل نداء
# API بـ301 لا يستمع إليه أحد فيرى المتصفّح «Failed to fetch»
SECURE_SSL_REDIRECT=0

# ── الواجهات ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── تعبئة البيانات عند إقلاع الحاويات ────────────────────
WALAEE_SEED_NETWORK=1
WALAEE_SEED_ACTIVITY=1
WEB_PORT=8081
